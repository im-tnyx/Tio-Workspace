{
  "name": "tnyx",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "tokens:check": "node scripts/check-design-tokens.cjs",
    "tokens:self-test": "node scripts/check-design-tokens.cjs --self-test",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:task06i": "node --test experiments/task06i/*.test.mjs",
    "verify": "npm run tokens:self-test && npm run tokens:check && npm run typecheck && npm run lint && npm test && npm run test:task06i",
    "expo:check": "expo install --check",
    "mobile": "expo start --tunnel --go"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
